<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SpaRoot>..\..\web\</SpaRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentContext.Application\AgentContext.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

  <!--
    Build the React UI (repo-root web/) into wwwroot when building. Vite writes
    straight to ../wwwroot of this project. Skip with -p:SkipSpaBuild=true
    (used by the Dockerfile, which prebuilds the UI in a node stage).
  -->
  <Target Name="BuildSpa" BeforeTargets="BeforeBuild" Condition="'$(SkipSpaBuild)' != 'true' And Exists('$(SpaRoot)package.json')">
    <Exec Command="npm ci" WorkingDirectory="$(SpaRoot)" Condition="!Exists('$(SpaRoot)node_modules\.package-lock.json')" />
    <Exec Command="npm run build" WorkingDirectory="$(SpaRoot)" />
  </Target>

</Project>
