<Project Sdk="Microsoft.NET.Sdk.Web;Aspire.AppHost.Sdk/13.4.6">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SpaRoot>..\..\web\</SpaRoot>
    <!-- The apphost mode (Aspire.AppHost.Sdk) defaults TreatProjectReferencesAsResources=true and
         IsPublishable=false — this Host must keep its normal ProjectReference to Application and
         stay publishable for the Dockerfile, so both defaults are overridden here. -->
    <TreatProjectReferencesAsResources>false</TreatProjectReferencesAsResources>
    <IsPublishable>true</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentContext.Application\AgentContext.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Serilog.AspNetCore" />
    <!-- T13 (issue #14): OpenTelemetry — logs (Serilog dual-write) + traces + metrics on by default. -->
    <PackageReference Include="Serilog.Sinks.OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <!-- T13 follow-up: the apphost mode (args flag) runs this same binary as an Aspire
         DistributedApplication — Resources view + service graph in the dashboard.
         Aspire.Hosting.AppHost (not the bare Aspire.Hosting) ships the DCP + dashboard
         binaries the AppHost needs at runtime; it also keeps publish/ProjectReference
         untouched (Aspire.AppHost.Sdk would disable both). -->
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
  </ItemGroup>

  <!--
    Build the React UI (repo-root web/) into wwwroot when building. Vite writes
    straight to ../wwwroot of this project. Skip with -p:SkipSpaBuild=true
    (used by the Dockerfile, which prebuilds the UI in a node stage).
  -->
  <Target Name="BuildSpa" BeforeTargets="BeforeBuild" Condition="'$(SkipSpaBuild)' != 'true' And Exists('$(SpaRoot)package.json')">
    <Exec Command="npm ci" WorkingDirectory="$(SpaRoot)" Condition="!Exists('$(SpaRoot)node_modules\.package-lock.json')" />
    <Exec Command="npm run build" WorkingDirectory="$(SpaRoot)" />
  </Target>

  <!--
    Aspire.AppHost.Sdk (the apphost mode) perturbs the Web SDK's StaticWebAssets
    ordering (its own docs warn about this), so wwwroot stops landing in the output
    directory. Copy it explicitly so both the apphost child process and the
    Dockerfile publish keep serving the built UI.
  -->
  <Target Name="CopyWwwrootToOutput" AfterTargets="Build"
          Condition="Exists('$(MSBuildProjectDirectory)\wwwroot')">
    <ItemGroup>
      <_WwwrootFiles Include="$(MSBuildProjectDirectory)\wwwroot\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_WwwrootFiles)"
          DestinationFiles="@(_WwwrootFiles->'$(OutDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
